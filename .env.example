# Plan server (src/server/plan-server.ts) - copy to .env for local dev,
# or set these as environment variables in Dokploy.

# Required. Shared secret gating both viewing and publishing the plan.
# Generate one with: openssl rand -hex 32
PLAN_TOKEN=

# Optional. Defaults shown.
PORT=3000
DATA_DIR=./data

# Used by `npx runnify-assistant publish` (the coach / coach-checkin skills'
# CLI publish step) instead of passing --server/--token each time.
RUNNIFY_SERVER_URL=http://localhost:3000
RUNNIFY_SERVER_TOKEN=
